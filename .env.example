# ─────────────────────────────────────────────────────
# Riqueza Oculta v2 — variáveis de ambiente
# Copiar para .env.local e preencher os valores
# Este ficheiro pode ser commitado (sem valores reais)
# ─────────────────────────────────────────────────────

# URL pública da app (em produção: https://riquezaoculta.click)
NEXT_PUBLIC_APP_URL=https://SEU_DOMINIO.vercel.app

# PostgreSQL — obter em https://neon.tech (gratuito)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# KB Agency (Multicaixa) — Referência/ATM e Express
KB_AGENCY_API_KEY=sk_express_...
KB_API_EXPRESS_KEY=
KB_AGENCY_WEBHOOK_SECRET=whsec_...

# SMS — BulkGate
BULKGATE_APP_ID=
BULKGATE_APP_TOKEN=

# Segurança — usar strings longas e aleatórias em produção
JWT_SECRET=
ADMIN_PASSWORD=

# Notificações push (opcional)
# PUSHCUT_URL=https://api.pushcut.io/...

# Chat IA — Sofia (Google Gemini — opcional, funciona com fallback sem key)
# Obter em https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Meta Pixel (Facebook Conversions API — server-side)
FACEBOOK_PIXEL_ID=3844166525887650
FACEBOOK_ACCESS_TOKEN=

# Kambafy — checkout externo
KAMBAFY_CHECKOUT_URL=https://pay.kambafy.com/checkout/bd59f082-a243-4c64-87dd-9dc9d5f1e4eb
KAMBAFY_WEBHOOK_SECRET=

# WhatsApp — OpenWA (confirmações, lembretes e recuperação de carrinho)
# Sem estas variáveis o envio de WhatsApp é ignorado silenciosamente (no-op)
OPENWA_API_URL=
OPENWA_API_KEY=
OPENWA_SESSION_ID=

# Cron — segredo para autorizar /api/cron/recover-pending (Vercel Cron usa assinatura própria)
CRON_SECRET=
